{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: NpcCompass -> BepInEx plugins",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "NpcCompass.csproj",
        "--no-restore",
        "-c",
        "Release",
        "-p:OutputPath=../../BepInEx/plugins/NpcCompass/",
        "-p:IntermediateOutputPath=.vscode/obj/Release/",
        "-p:AppendTargetFrameworkToOutputPath=false"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "build: NpcCompass -> custom output folder",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "NpcCompass.csproj",
        "--no-restore",
        "-c",
        "Release",
        "-p:OutputPath=${input:outputFolder}",
        "-p:IntermediateOutputPath=.vscode/obj/Release/",
        "-p:AppendTargetFrameworkToOutputPath=false"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "outputFolder",
      "type": "promptString",
      "description": "Output folder for NpcCompass.dll, relative to dev/NpcCompass or absolute",
      "default": "../../BepInEx/plugins/NpcCompass/"
    }
  ]
}
